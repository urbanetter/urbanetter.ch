---
layout: layouts/page.njk
title: "Hi, I'm Urban"
description: "Engineering leader building playful, humane software products, experiments, and communities."
---

<section class="hero">
  <span class="hero__kicker">Software crafter · Facilitator · Creative coder</span>
  <h1 class="hero__title">Building teams and tools that feel good to use.</h1>
  <p class="hero__subtitle">I am a tech lead at SRF, explore playful interfaces through creative coding, and share what I learn about software development.</p>

<section class="section">
  <h2 class="section__heading">Latest writing <small>Thoughts on humane engineering & craft</small></h2>
  <div class="grid grid--two">
    {% for post in collections.writing | slice(0,3) %}
      <article class="card">
        <p class="card__kicker">Writing · {{ post.date | readableDate }}</p>
        <h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.summary }}</p>
        <div class="card__actions"><a href="{{ post.url }}">Read post →</a></div>
      </article>
    {% endfor %}
  </div>
  <p style="margin-top:1.5rem"><a href="/writing/">Browse all writing →</a></p>
</section>

<section class="section">
  <h2 class="section__heading">Creative coding <small>Generative sketches & visual experiments</small></h2>
  <div class="grid grid--two">
    {% for experiment in collections.experiments %}
      <article class="card">
        {% if experiment.data.image %}
          <div class="card__media"><img src="{{ experiment.data.image }}" alt="{{ experiment.data.title }}"></div>
        {% endif %}
        <p class="card__kicker">Experiment</p>
        <h3 class="card__title"><a href="{{ experiment.url }}">{{ experiment.data.title }}</a></h3>
        <p>{{ experiment.data.summary }}</p>
        <div class="card__actions"><a href="{{ experiment.url }}">Open notes →</a></div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="section">
  <h2 class="section__heading">Selected projects <small>Long-running things I keep coming back to</small></h2>
  <div class="grid grid--two">
    {% for project in collections.projects %}
      <article class="card">
        <p class="card__kicker">Project</p>
        <h3 class="card__title"><a href="{{ project.url }}">{{ project.data.title }}</a></h3>
        <p class="card__meta">{{ project.data.role }}</p>
        <p>{{ project.data.summary }}</p>
        <div class="card__actions">
          {% if project.data.primaryLink %}
            <a href="{{ project.data.primaryLink.url }}">{{ project.data.primaryLink.label }} →</a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="section">
  <h2 class="section__heading">Talks & workshops <small>Sharing at conferences and communities</small></h2>
  <div class="grid grid--two">
    {% for talk in collections.talks %}
      <article class="card">
        <p class="card__kicker">{{ talk.date | readableDate }}</p>
        <h3 class="card__title"><a href="{{ talk.url }}">{{ talk.data.title }}</a></h3>
        <p class="card__meta">{{ talk.data.event }}</p>
        <p>{{ talk.data.summary }}</p>
        <div class="card__actions">
          {% if talk.data.links %}
            {% for link in talk.data.links %}
              <a href="{{ link.url }}">{{ link.label }} →</a>{% if not loop.last %} &nbsp;{% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  <p style="margin-top:1.5rem"><a href="/talks/">See all talks →</a></p>
</section>
